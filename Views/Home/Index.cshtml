@{
    ViewData["Title"] = "Tổng quan";
    ViewData["PageHeading"] = "Tổng quan cửa hàng";
}

<section class="animate-rise relative mb-6 grid overflow-hidden rounded-lg bg-gradient-to-br from-[#2d5aa3] to-[#1f437a] p-6 text-white shadow-[0_18px_44px_rgba(33,70,128,.12)] lg:grid-cols-[minmax(0,1fr)_300px] lg:gap-6 lg:p-8">
    <div class="bg-grid pointer-events-none absolute inset-0 opacity-40"></div>
    <div class="relative z-10">
        <p class="mb-2 text-xs font-black uppercase text-white/70">MiniStop Management</p>
        <h2 class="m-0 max-w-3xl text-3xl font-black leading-tight tracking-normal lg:text-[34px]">Vận hành cửa hàng mượt hơn, nắm số liệu nhanh hơn.</h2>
        <p class="mt-4 max-w-2xl text-white/80">Theo dõi doanh thu, đơn hàng, tồn kho và ca làm trong một giao diện gọn, rõ và sẵn sàng mở rộng.</p>
        <div class="mt-5 flex flex-wrap gap-3">
            <button class="rounded-lg bg-[#f2c94c] px-4 py-2 text-sm font-black text-[#173560] shadow-[0_10px_22px_rgba(242,201,76,.24)] transition hover:-translate-y-0.5" type="button">Kiểm tra tồn kho</button>
            <button class="rounded-lg border border-white/60 px-4 py-2 text-sm font-black text-white transition hover:-translate-y-0.5 hover:bg-white/10" type="button">Xem đơn trong ngày</button>
        </div>
    </div>

    <div class="relative z-10 mt-6 grid gap-2 rounded-lg border border-white/25 bg-white/15 p-5 lg:mt-0">
        <span class="text-white/75">Doanh thu hôm nay</span>
        <strong class="text-3xl font-black">18.450.000 đ</strong>
        <div class="flex items-center justify-between">
            <small class="text-white/75">+12% so với hôm qua</small>
            <span class="pulse-dot h-3 w-3 rounded-full bg-[#f2c94c]"></span>
        </div>
    </div>
</section>

